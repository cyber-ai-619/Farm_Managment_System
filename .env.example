APP_NAME=Farm Management System
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api
APP_SECRET=change-this-to-a-long-random-string-in-production

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=farm_management
DB_USERNAME=farm_user
DB_PASSWORD=farm_password
MYSQL_ROOT_PASSWORD=root_password

# Frontend URL (for generating email links)
FRONTEND_URL=http://localhost:5173

# Email Delivery Configuration (Free via Gmail SMTP or Brevo)
# Driver options: smtp | brevo | log
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-farm-email@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
MAIL_FROM_ADDRESS=your-farm-email@gmail.com
MAIL_FROM_NAME="Farm Management System"

# If using Brevo HTTP API:
# MAIL_DRIVER=brevo
# BREVO_API_KEY=xkeysib-...
